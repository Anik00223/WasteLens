# Large model artifacts are produced locally / on Colab Drive - never commit.
models/checkpoints/*.keras
models/checkpoints/*.h5

# Python
__pycache__/
*.pyc

# Node dependencies (installed locally for the browser-runtime proof harness;
# package.json / package-lock.json pin them for reproducibility).
node_modules/

